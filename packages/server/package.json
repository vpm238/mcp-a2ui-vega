{
  "name": "@mcp-a2ui-vega/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The MCP server: tools, datasets, saved widgets, and the ui:// app resource.",
  "scripts": {
    "dev": "npm run assets && wrangler dev",
    "build": "npm run assets && tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run assets && wrangler deploy",
    "test": "node --test test/*.test.mjs",
    "assets": "node scripts/bundle-assets.mjs"
  },
  "dependencies": {
    "@mcp-a2ui-vega/catalog": "*",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
